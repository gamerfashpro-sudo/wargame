# ---------- Text ----------
* text=auto
*.cs       text eol=lf diff=csharp
*.shader   text eol=lf
*.hlsl     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.py       text eol=lf
*.uss      text eol=lf
*.uxml     text eol=lf

# Unity YAML (scenes, prefabs, assets) — text, smart merge
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.mat      text eol=lf merge=unityyamlmerge
*.anim     text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta     text eol=lf

# ---------- Binaries ----------
# Git LFS отключён: сетевой фильтр облачной среды разработки не пускает к хранилищу LFS
# (github-cloud.s3.amazonaws.com). Файлы хранятся обычным Git (лимит GitHub: 100 МБ на файл).
# Включить LFS позже: заменить 'binary' на 'filter=lfs diff=lfs merge=lfs -text' и выполнить git lfs migrate.
# 3D
*.blend  binary
*.fbx    binary
*.FBX    binary
*.obj    binary
*.glb    binary
# Images
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.tif    binary
*.tiff   binary
*.psd    binary
*.exr    binary
*.hdr    binary
# Audio / video
*.wav    binary
*.mp3    binary
*.ogg    binary
*.mp4    binary
# Fonts / archives
*.ttf    binary
*.otf    binary
*.zip    binary
